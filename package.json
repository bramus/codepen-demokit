{
  "name": "codepen-demokit",
  "version": "1.0.0",
  "description": "A zero-config framework for organizing, previewing, deploying, and syncing self-contained vanilla web platform demos with CodePen 2.0.",
  "type": "module",
  "bin": {
    "codepen-demokit": "./bin/cli.mjs"
  },
  "exports": {
    "./build-json": "./lib/build-json.mjs",
    "./build-site": "./lib/build-site.mjs",
    "./config": "./lib/config.mjs",
    "./init": "./lib/init.mjs",
    "./serve": "./lib/serve.mjs",
    "./sync-codepen": "./lib/sync-codepen.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "shell/",
    "templates/",
    "README.md"
  ],
  "keywords": [
    "codepen",
    "codepen-commander",
    "demos",
    "web-platform",
    "vanilla-js",
    "static-site"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "codepen-commander": "^1.3.0"
  }
}
